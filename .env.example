# 実値は .env（ローカル） / Vercel の環境変数（本番）に設定する。

# --- Database (server only) ---
# Prisma(adapter-pg) が直結する Supabase Postgres 接続文字列
SUPABASE_DATABASE_URL=
# 使用するスキーマ: develop（開発）/ public（本番）。本番は public を指定
SUPABASE_DATABASE_SCHEMA=

# --- Auth / Session (server only) ---
# Cookie セッションの署名に使う秘密鍵（十分に長いランダム値）
SESSION_SECRET=

# --- Cron (server only) ---
# 定期実体化 Cron（/api/cron/post-records）の Bearer 認証に使う秘密。
# Vercel Cron が Authorization: Bearer <値> を付与する。未設定なら Cron は無効（503）。
CRON_SECRET=

# --- Supabase Auth (client / NEXT_PUBLIC_*) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
